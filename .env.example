# Which LLM provider to use: groq | gemini | ollama
LLM_PROVIDER=groq

# --- Groq (recommended: free, fast, no card needed) ---
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Gemini (free tier alternative) ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# --- Ollama (fully local, no key needed) ---
# Install from https://ollama.com and run: ollama pull llama3.1
OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434

# --- Storage ---
DATABASE_URL=sqlite:///./data/app.db
CHROMA_DIR=./data/chroma_db

# --- Retrieval / chunking ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5
